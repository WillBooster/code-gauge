{
  "name": "code-gauge",
  "version": "0.0.0-semantically-released",
  "description": "Measure code metrics with tree-sitter.",
  "keywords": [
    "cli",
    "cognitive-complexity",
    "csharp",
    "duplication",
    "kotlin",
    "loc",
    "metrics",
    "ncss",
    "refactoring",
    "tree-sitter"
  ],
  "license": "Apache-2.0",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/code-gauge.git"
  },
  "bin": "dist/cli.js",
  "files": [
    "dist/",
    "native/build.rs",
    "native/Cargo.lock",
    "native/Cargo.toml",
    "native/code-gauge.wasm",
    "native/src/",
    "scripts/buildNative.mjs",
    "scripts/installNative.mjs",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/worker.js",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "benchmark": "node scripts/benchmark.mjs",
    "build": "build-ts lib -i src/index.ts -i src/cli.ts -i src/worker.ts --external ../native/code-gauge.wasm",
    "build-native": "node scripts/buildNative.mjs",
    "build-wasm": "node scripts/buildWasm.mjs",
    "calibrate-thresholds": "bun scripts/calibrateThresholds.ts",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "postinstall": "node scripts/installNative.mjs",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "dependencies": {
    "@willbooster/shared-lib": "10.18.0",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@tsconfig/bun": "1.0.10",
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/node-ts": "23.6.4",
    "@types/bun": "1.4.4",
    "@types/node": "25.9.4",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "23.0.1",
    "build-ts": "21.0.31",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "2.2.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "semantic-release": "25.0.5",
    "vitest": "4.1.9",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=24"
  }
}
